# MongoDB connection string (e.g. MongoDB Atlas)
MONGODB_URI=

# Google Gemini API key
GEMINI_API_KEY=

# Clerk authentication keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk redirect URLs (optional — defaults shown)
